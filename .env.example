# Groq API Key (for Llama-3.1-8b-instant LLM generation & verification)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional - for text-embedding-3-small embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Key (optional - alternative embedding provider)
OPEN_ROUTER_KEY=your_openrouter_api_key_here

# LangChain Tracing & Monitoring (optional - for LangSmith observability)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=RAG Pipeline with Hybrid Search Over Internal Docs
